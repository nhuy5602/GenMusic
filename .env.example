GENMUSIC_OUTPUT_DIR=outputs
GENMUSIC_DEFAULT_DURATION=16

# Kaggle credentials. Use either KAGGLE_API_TOKEN or the legacy key pair.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KEY=

# Written automatically to .genmusic/kaggle.json by the native corpus
# bootstrap. Set this only when you want to override that local config.
GENMUSIC_NATIVE_RAW_KERNEL_REF=

# Optional research-pipeline inputs. No account-specific refs are committed.
KAGGLE_PROCESSED_KERNEL_REF=
KAGGLE_PROCESSED_DATASET_REF=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_1=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_2=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_3=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_4=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_5=
GENMUSIC_PROCESSED_RAW_KERNEL_PART_6=
